{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:backend": "tsx watch backend/src/server.ts",
    "dev:full": "npm run dev & npm run dev:backend",
    "build": "npm run build:web",
    "build:web": "vite build",
    "build:backend": "esbuild backend/src/server.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=backend/dist/server.js",
    "build:production": "npm run typecheck && npm run compile && npm run build:web && npm run build:backend",
    "start": "npm run start:backend",
    "start:backend": "node backend/dist/server.js",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit && tsc -p backend/tsconfig.json --noEmit",
    "typecheck": "tsc --noEmit && tsc -p backend/tsconfig.json --noEmit",
    "compile": "hardhat --config hardhat.config.cjs compile",
    "test": "hardhat --config hardhat.config.cjs test",
    "deploy:sepolia": "hardhat --config hardhat.config.cjs run scripts/deploy.ts --network sepolia",
    "deploy:arbitrum-sepolia": "hardhat --config hardhat.config.cjs run scripts/deploy.ts --network arbitrumSepolia",
    "deploy:base-sepolia": "hardhat --config hardhat.config.cjs run scripts/deploy.ts --network baseSepolia"
  },
  "dependencies": {
    "@cofhe/react": "0.5.2",
    "@cofhe/sdk": "0.5.2",
    "@openzeppelin/contracts": "5.0.2",
    "@rainbow-me/rainbowkit": "^2.2.10",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.95.2",
    "@vitejs/plugin-react": "^5.0.4",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "ethers": "^6.15.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.13.1",
    "viem": "^2.47.6",
    "vite": "^6.2.0",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@cofhe/hardhat-plugin": "0.5.2",
    "@fhenixprotocol/cofhe-contracts": "0.1.3",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "hardhat": "^2.22.18",
    "tailwindcss": "^4.1.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typechain": "^8.3.2",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
